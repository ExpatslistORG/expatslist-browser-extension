{
  "manifest_version": 3,
  "name": "ExpatsList.org",
  "description": "See what's new in your ExpatsList.org city, and jump straight to your ExpatsList.org messages.",
  "version": "2.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "ExpatsList.org",
    "default_popup": "popup.html"
  },
  "permissions": ["storage"]
}
